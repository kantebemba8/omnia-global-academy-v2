{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build:native": "vite build --mode native",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:mobile:module1": "node scripts/mobile/verify-module1.mjs --source",
    "test:mobile:web": "node scripts/mobile/verify-module1.mjs --web",
    "test:mobile:native": "node scripts/mobile/verify-module1.mjs --native",
    "mobile:sync": "npm run build:native && cap sync",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:assets": "capacitor-assets generate --iconBackgroundColor \"#FFFFFF\" --iconBackgroundColorDark \"#002050\" --splashBackgroundColor \"#FFFFFF\" --splashBackgroundColorDark \"#002050\"",
    "mobile:assets:android": "capacitor-assets generate --android --iconBackgroundColor \"#FFFFFF\" --iconBackgroundColorDark \"#002050\" --splashBackgroundColor \"#FFFFFF\" --splashBackgroundColorDark \"#002050\"",
    "mobile:assets:ios": "capacitor-assets generate --ios --iconBackgroundColor \"#FFFFFF\" --iconBackgroundColorDark \"#002050\" --splashBackgroundColor \"#FFFFFF\" --splashBackgroundColorDark \"#002050\""
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@sentry/react": "^10.63.0",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^3.9.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
