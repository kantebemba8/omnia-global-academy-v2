{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build:native": "vite build --mode native",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:mobile:module1": "node scripts/mobile/verify-module1.mjs --source",
    "test:mobile:web": "node scripts/mobile/verify-module1.mjs --web",
    "test:mobile:native": "node scripts/mobile/verify-module1.mjs --native",
    "mobile:sync": "npm run build:native && cap sync",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:assets": "capacitor-assets generate --iconBackgroundColor \"#FFFFFF\" --iconBackgroundColorDark \"#002050\" --splashBackgroundColor \"#FFFFFF\" --splashBackgroundColorDark \"#002050\"",
    "mobile:assets:android": "capacitor-assets generate --android --iconBackgroundColor \"#FFFFFF\" --iconBackgroundColorDark \"#002050\" --splashBackgroundColor \"#FFFFFF\" --splashBackgroundColorDark \"#002050\"",
    "mobile:assets:ios": "capacitor-assets generate --ios --iconBackgroundColor \"#FFFFFF\" --iconBackgroundColorDark \"#002050\" --splashBackgroundColor \"#FFFFFF\" --splashBackgroundColorDark \"#002050\"",
    "test:mobile:module2": "node scripts/mobile/verify-module2.mjs --source",
    "test:mobile:module2:android": "node scripts/mobile/verify-module2.mjs --android",
    "test:mobile:module3": "node scripts/mobile/verify-module3.mjs --source",
    "test:mobile:module3:android": "node scripts/mobile/verify-module3.mjs --android",
    "mobile:module3:ios": "node scripts/mobile/apply-module3-ios.mjs",
    "test:mobile:module4": "node scripts/mobile/verify-module4.mjs --source",
    "test:mobile:module4:android": "node scripts/mobile/verify-module4.mjs --android",
    "mobile:module4:ios": "node scripts/mobile/apply-module4-ios.mjs",
    "mobile:configure-links": "node scripts/mobile/configure-app-links.mjs",
    "test:mobile:module4:supabase": "node scripts/mobile/verify-module4.mjs --supabase",
    "test:mobile:module5": "node scripts/mobile/verify-module5.mjs --source",
    "test:mobile:module5:android": "node scripts/mobile/verify-module5.mjs --android",
    "test:mobile:module5:supabase": "node scripts/mobile/verify-module5.mjs --supabase",
    "mobile:module5:ios": "node scripts/mobile/apply-module5-ios.mjs",
    "test:mobile:module6": "node scripts/mobile/verify-module6.mjs --source",
    "test:mobile:module6:android": "node scripts/mobile/verify-module6.mjs --android",
    "test:mobile:module6:supabase": "node scripts/mobile/verify-module6.mjs --supabase",
    "test:mobile:module6:release": "node scripts/mobile/verify-module6.mjs --release",
    "mobile:module6:ios": "node scripts/mobile/apply-module6-ios.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/camera": "8.2.1",
    "@capacitor/core": "8.4.2",
    "@capacitor/device": "8.0.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@sentry/capacitor": "4.3.0",
    "@sentry/react": "10.69.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tiptap/core": "3.30.3",
    "@tiptap/extension-image": "3.30.3",
    "@tiptap/extension-table": "3.30.3",
    "@tiptap/pm": "3.30.3",
    "@tiptap/react": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "@uppy/core": "6.0.1",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "jsqr": "1.4.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^3.9.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "sharp@0.32.6": true
  },
  "overrides": {
    "@tiptap/extension-bubble-menu": "3.30.3",
    "@tiptap/extension-floating-menu": "3.30.3"
  }
}
